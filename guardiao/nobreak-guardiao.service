# Serviço de USUÁRIO do guardião de energia (systemd --user, sem root).
# Instalação:
#   mkdir -p ~/.config/systemd/user/
#   cp nobreak-guardiao.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now nobreak-guardiao.service
#
# Requer: NUT rodando (nut-driver@nobreak + upsd) e upsc no PATH.
# Personalize a ação na falta de luz editando a linha ExecStart,
# ex.: --on-cmd 'systemctl suspend'

[Unit]
Description=Guardião de energia — vigia o nobreak e notifica faltas de luz
# Espera o upsd subir antes de começar a pollar
After=nut-server.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/nobreak-mec0003/guardiao/guardiao-energia.py --ups nobreak@localhost --intervalo 5
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
