#!/usr/bin/env bash
# nobreak-autocura — "tira e bota" o USB do nobreak por software, em escada:
#   1) usbreset            (reset USB do aparelho)
#   2) ciclo authorized    (desativa/ativa o aparelho no sysfs)
#   3) rebind da controladora xHCI inteira (= replug físico de tudo nela;
#      teclado/mouse da mesma controladora piscam ~2 s)
# Depois de cada nível: reinicia o nut-driver e espera o upsc responder.
#   nobreak-autocura          checa; só age se o NUT estiver sem dados
#   nobreak-autocura --forcar age já
#   nobreak-autocura --nivel N começa no nível N
set -u
VIDPID=0001:0000; UNIT=nut-driver@nobreak.service; UPS=nobreak@localhost
STATE=/run/nobreak-autocura; mkdir -p "$STATE"
log(){ echo "nobreak-autocura: $*"; logger -t nobreak-autocura -- "$*"; }

saudavel(){ # upsc responde e a entrada ou a saída não está zerada
  local o; o=$(timeout 5 upsc "$UPS" 2>/dev/null) || return 1
  echo "$o" | grep -qE '^ups.status: ' || return 1
  echo "$o" | awk -F': ' '$1=="output.voltage"||$1=="input.voltage"{if($2+0>0)ok=1} END{exit !ok}'
}
devpath(){ for d in /sys/bus/usb/devices/*; do
  [ "$(cat $d/idVendor 2>/dev/null):$(cat $d/idProduct 2>/dev/null)" = "$VIDPID" ] && { echo "$d"; return; }; done; }
espera_nut(){ systemctl restart "$UNIT" 2>/dev/null; local i
  for i in $(seq 1 8); do sleep 5; saudavel && return 0; done; return 1; }

nivel1(){ log "nível 1: usbreset $VIDPID"; usbreset "$VIDPID" >/dev/null 2>&1; sleep 3; }
nivel2(){ local d; d=$(devpath); [ -n "$d" ] || { log "nível 2: aparelho sumiu do USB"; return; }
  log "nível 2: ciclo authorized em $d"; echo 0 > "$d/authorized"; sleep 3; echo 1 > "$d/authorized"; sleep 4; }
nivel3(){ local d pci; d=$(devpath)
  [ -n "$d" ] || d=$(cat "$STATE/ultimo-dev" 2>/dev/null)
  pci=$(readlink -f "$d" | grep -oE '[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9]' | tail -1)
  [ -n "$pci" ] || pci=$(cat "$STATE/ultimo-pci" 2>/dev/null)
  [ -n "$pci" ] || { log "nível 3: não achei a controladora"; return; }
  log "nível 3: rebind da controladora xHCI $pci"
  echo "$pci" > /sys/bus/pci/drivers/xhci_hcd/unbind; sleep 3
  echo "$pci" > /sys/bus/pci/drivers/xhci_hcd/bind; sleep 6; }

# guarda onde o aparelho está (para o nível 3 achar a controladora mesmo se ele sumir)
d=$(devpath); [ -n "$d" ] && { echo "$d" > "$STATE/ultimo-dev"
  readlink -f "$d" | grep -oE '[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9]' | tail -1 > "$STATE/ultimo-pci"; }

INI=1; FORCAR=0
case "${1:-}" in --forcar) FORCAR=1;; --nivel) FORCAR=1; INI=${2:-1};; esac
if [ $FORCAR -eq 0 ]; then
  if saudavel; then rm -f "$STATE/falhas"; exit 0; fi
  n=$(( $(cat "$STATE/falhas" 2>/dev/null || echo 0) + 1 )); echo $n > "$STATE/falhas"
  [ $n -lt 2 ] && { log "NUT sem dados (1ª checagem); aguardo a próxima"; exit 0; }
  # no máximo 4 curas por hora
  find "$STATE" -name 'cura-*' -mmin +60 -delete
  [ "$(ls "$STATE"/cura-* 2>/dev/null | wc -l)" -ge 4 ] && { log "limite de 4 curas/hora; não ajo"; exit 1; }
fi
touch "$STATE/cura-$(date +%s)"
for n in 1 2 3; do
  [ $n -lt "$INI" ] && continue
  nivel$n
  if espera_nut; then log "OK: NUT voltou após nível $n"; rm -f "$STATE/falhas"; exit 0; fi
done
log "FALHOU: nenhum nível trouxe o NUT de volta (precisa de replug físico)"; exit 1
