# =============================================================================
# nobreak-mec0003.service — driver standalone (sem NUT) para nobreaks com chip
# USB MEC0003 (0001:0000). Instalado em /etc/systemd/system pelo install.sh
# (--mode standalone); espera o venv em /usr/local/lib/nobreak-mec0003.
# =============================================================================
[Unit]
Description=Nobreak MEC0003 - driver standalone (Megatec Q1 via USB)
Documentation=file:/usr/local/lib/nobreak-mec0003
# Não conflita com NUT diretamente, mas os DOIS não podem falar com o chip ao
# mesmo tempo (o firmware trava sob acesso concorrente/protocolo errado).
Conflicts=nobreak-mec0003-mqtt.service nut-driver@nobreak.service
After=multi-user.target

[Service]
Type=simple
# -u: log sem buffer (o firmware é lento para acordar, queremos ver tudo no
# journal). O driver faz o aquecimento ~1Hz pós-plug internamente.
ExecStart=/usr/local/lib/nobreak-mec0003/venv/bin/python -u /usr/local/lib/nobreak-mec0003/mec0003.py --daemon
Restart=always
RestartSec=10
# --- Dica de privilégio (ambient hint) ---------------------------------------
# O acesso é RAW via libusb/usbfs. A forma mais simples é rodar como root
# (padrão: nenhuma directive User= acima). Para rodar sem root, o usuário
# precisa pertencer ao grupo da regra udev 99-nobreak-mec0003.rules ("nut" no
# Arch e no Debian/Ubuntu; "plugdev" como fallback escolhido pelo install.sh)
# E o serviço precisa de permissão de escrita em /dev/bus/usb (garantida pela
# mesma regra, MODE=0664). Descomente e ajuste para rebaixar:
#User=nut
#Group=nut
#SupplementaryGroups=

[Install]
WantedBy=multi-user.target
