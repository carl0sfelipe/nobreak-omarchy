# =============================================================================
# nobreak-mec0003-mqtt.service — variante MQTT do driver standalone: lê o
# nobreak com chip USB MEC0003 (0001:0000) e publica no broker configurado em
# /etc/nobreak-mec0003.env (criado pelo install.sh --mode mqtt).
# =============================================================================
[Unit]
Description=Nobreak MEC0003 - driver standalone com publicacao MQTT
Documentation=file:/usr/local/lib/nobreak-mec0003
# Mesmo chip do serviço standalone: nunca rodar os dois juntos.
Conflicts=nobreak-mec0003.service
Wants=network-online.target
After=multi-user.target network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/nobreak-mec0003.env
# As variáveis vêm do EnvironmentFile (expansão feita pelo systemd):
#   MQTT_BROKER/MQTT_PORT → --mqtt broker:porta · MQTT_TOPIC_PREFIX → tópico
#   POLL_SECONDS → cadência do daemon (2s mantém o chip "vivo" pós-plug)
# Bônus do driver: defina NUT_ON_BATTERY_CMD no env p/ rodar um comando
# quando o nobreak entrar em bateria.
ExecStart=/usr/local/lib/nobreak-mec0003/venv/bin/python -u /usr/local/lib/nobreak-mec0003/mec0003.py --daemon --interval ${POLL_SECONDS} --mqtt ${MQTT_BROKER}:${MQTT_PORT} --mqtt-topic ${MQTT_TOPIC_PREFIX}/state
Restart=always
RestartSec=10
# --- Dica de privilégio (ambient hint) ---------------------------------------
# Igual ao serviço standalone: acesso raw USB. Root é o padrão; para rodar sem
# root, use o grupo da regra udev ("nut" no Arch/Debian, "plugdev" fallback).
#User=nut
#Group=nut

[Install]
WantedBy=multi-user.target
